<?xml version="1.0" encoding="windows-1252"?>
<?eclipse version="3.0"?>
<plugin>
	<extension
		point="org.eclipse.ui.handlers">
		<handler
			class="org.uniovi.dsl.scheduling.ui.SchedulingExecutableExtensionFactory:org.eclipse.xtext.ui.editor.hyperlinking.OpenDeclarationHandler"
			commandId="org.eclipse.xtext.ui.editor.hyperlinking.OpenDeclaration">
			<activeWhen>
				<reference
					definitionId="org.uniovi.dsl.scheduling.Scheduling.Editor.opened">
				</reference>
			</activeWhen>
		</handler>
		<handler
			class="org.uniovi.dsl.scheduling.ui.SchedulingExecutableExtensionFactory:org.eclipse.xtext.ui.editor.handler.ValidateActionHandler"
			commandId="org.uniovi.dsl.scheduling.Scheduling.validate">
			<activeWhen>
				<reference
					definitionId="org.uniovi.dsl.scheduling.Scheduling.Editor.opened">
				</reference>
			</activeWhen>
		</handler>
		<!-- copy qualified name -->
		<handler
			class="org.uniovi.dsl.scheduling.ui.SchedulingExecutableExtensionFactory:org.eclipse.xtext.ui.editor.copyqualifiedname.EditorCopyQualifiedNameHandler"
			commandId="org.eclipse.xtext.ui.editor.copyqualifiedname.EditorCopyQualifiedName">
			<activeWhen>
				<reference definitionId="org.uniovi.dsl.scheduling.Scheduling.Editor.opened" />
			</activeWhen>
		</handler>
		<handler
			class="org.uniovi.dsl.scheduling.ui.SchedulingExecutableExtensionFactory:org.eclipse.xtext.ui.editor.copyqualifiedname.OutlineCopyQualifiedNameHandler"
			commandId="org.eclipse.xtext.ui.editor.copyqualifiedname.OutlineCopyQualifiedName">
			<activeWhen>
				<and>
					<reference definitionId="org.uniovi.dsl.scheduling.Scheduling.XtextEditor.opened" />
					<iterate>
						<adapt type="org.eclipse.xtext.ui.editor.outline.IOutlineNode" />
					</iterate>
				</and>
			</activeWhen>
		</handler>
	</extension>
	<extension point="org.eclipse.core.expressions.definitions">
		<definition id="org.uniovi.dsl.scheduling.Scheduling.Editor.opened">
			<and>
				<reference definitionId="isActiveEditorAnInstanceOfXtextEditor"/>
				<with variable="activeEditor">
					<test property="org.eclipse.xtext.ui.editor.XtextEditor.languageName"
						value="org.uniovi.dsl.scheduling.Scheduling"
						forcePluginActivation="true"/>
				</with>
			</and>
		</definition>
		<definition id="org.uniovi.dsl.scheduling.Scheduling.XtextEditor.opened">
			<and>
				<reference definitionId="isXtextEditorActive"/>
				<with variable="activeEditor">
					<test property="org.eclipse.xtext.ui.editor.XtextEditor.languageName"
						value="org.uniovi.dsl.scheduling.Scheduling"
						forcePluginActivation="true"/>
				</with>
			</and>
		</definition>
	</extension>
	<extension
			point="org.eclipse.ui.preferencePages">
		<page
			class="org.uniovi.dsl.scheduling.ui.SchedulingExecutableExtensionFactory:org.eclipse.xtext.ui.editor.preferences.LanguageRootPreferencePage"
			id="org.uniovi.dsl.scheduling.Scheduling"
			name="Scheduling">
			<keywordReference id="org.uniovi.dsl.scheduling.ui.keyword_Scheduling"/>
		</page>
		<page
			category="org.uniovi.dsl.scheduling.Scheduling"
			class="org.uniovi.dsl.scheduling.ui.SchedulingExecutableExtensionFactory:org.eclipse.xtext.ui.editor.syntaxcoloring.SyntaxColoringPreferencePage"
			id="org.uniovi.dsl.scheduling.Scheduling.coloring"
			name="Syntax Coloring">
			<keywordReference id="org.uniovi.dsl.scheduling.ui.keyword_Scheduling"/>
		</page>
		<page
			category="org.uniovi.dsl.scheduling.Scheduling"
			class="org.uniovi.dsl.scheduling.ui.SchedulingExecutableExtensionFactory:org.eclipse.xtext.ui.editor.templates.XtextTemplatePreferencePage"
			id="org.uniovi.dsl.scheduling.Scheduling.templates"
			name="Templates">
			<keywordReference id="org.uniovi.dsl.scheduling.ui.keyword_Scheduling"/>
		</page>
	</extension>
	<extension
			point="org.eclipse.ui.propertyPages">
		<page
			class="org.uniovi.dsl.scheduling.ui.SchedulingExecutableExtensionFactory:org.eclipse.xtext.ui.editor.preferences.LanguageRootPreferencePage"
			id="org.uniovi.dsl.scheduling.Scheduling"
			name="Scheduling">
			<keywordReference id="org.uniovi.dsl.scheduling.ui.keyword_Scheduling"/>
			<enabledWhen>
				<adapt type="org.eclipse.core.resources.IProject"/>
			</enabledWhen>
			<filter name="projectNature" value="org.eclipse.xtext.ui.shared.xtextNature"/>
		</page>
	</extension>
	<extension
		point="org.eclipse.ui.keywords">
		<keyword
			id="org.uniovi.dsl.scheduling.ui.keyword_Scheduling"
			label="Scheduling"/>
	</extension>
	<extension
		point="org.eclipse.ui.commands">
		<command
			description="Trigger expensive validation"
			id="org.uniovi.dsl.scheduling.Scheduling.validate"
			name="Validate">
		</command>
		<!-- copy qualified name -->
		<command
			id="org.eclipse.xtext.ui.editor.copyqualifiedname.EditorCopyQualifiedName"
			categoryId="org.eclipse.ui.category.edit"
			description="Copy the qualified name for the selected element"
			name="Copy Qualified Name">
		</command>
		<command
			id="org.eclipse.xtext.ui.editor.copyqualifiedname.OutlineCopyQualifiedName"
			categoryId="org.eclipse.ui.category.edit"
			description="Copy the qualified name for the selected element"
			name="Copy Qualified Name">
		</command>
	</extension>
	<extension point="org.eclipse.ui.menus">
		<menuContribution
			locationURI="popup:#TextEditorContext?after=group.edit">
			<command
				commandId="org.uniovi.dsl.scheduling.Scheduling.validate"
				style="push"
				tooltip="Trigger expensive validation">
				<visibleWhen checkEnabled="false">
					<reference
						definitionId="org.uniovi.dsl.scheduling.Scheduling.Editor.opened">
					</reference>
				</visibleWhen>
			</command>
		</menuContribution>
		<!-- copy qualified name -->
		<menuContribution locationURI="popup:#TextEditorContext?after=copy">
			<command commandId="org.eclipse.xtext.ui.editor.copyqualifiedname.EditorCopyQualifiedName"
				style="push" tooltip="Copy Qualified Name">
				<visibleWhen checkEnabled="false">
					<reference definitionId="org.uniovi.dsl.scheduling.Scheduling.Editor.opened" />
				</visibleWhen>
			</command>
		</menuContribution>
		<menuContribution locationURI="menu:edit?after=copy">
			<command commandId="org.eclipse.xtext.ui.editor.copyqualifiedname.EditorCopyQualifiedName"
				style="push" tooltip="Copy Qualified Name">
				<visibleWhen checkEnabled="false">
					<reference definitionId="org.uniovi.dsl.scheduling.Scheduling.Editor.opened" />
				</visibleWhen>
			</command>
		</menuContribution>
		<menuContribution locationURI="popup:org.eclipse.xtext.ui.outline?after=additions">
			<command commandId="org.eclipse.xtext.ui.editor.copyqualifiedname.OutlineCopyQualifiedName"
				style="push" tooltip="Copy Qualified Name">
				<visibleWhen checkEnabled="false">
					<and>
						<reference definitionId="org.uniovi.dsl.scheduling.Scheduling.XtextEditor.opened" />
						<iterate>
							<adapt type="org.eclipse.xtext.ui.editor.outline.IOutlineNode" />
						</iterate>
					</and>
				</visibleWhen>
			</command>
		</menuContribution>
	</extension>
	<extension point="org.eclipse.ui.menus">
		<menuContribution locationURI="popup:#TextEditorContext?endof=group.find">
			<command commandId="org.eclipse.xtext.ui.editor.FindReferences">
				<visibleWhen checkEnabled="false">
					<reference definitionId="org.uniovi.dsl.scheduling.Scheduling.Editor.opened">
					</reference>
				</visibleWhen>
			</command>
		</menuContribution>
	</extension>
	<extension point="org.eclipse.ui.handlers">
		<handler
			class="org.uniovi.dsl.scheduling.ui.SchedulingExecutableExtensionFactory:org.eclipse.xtext.ui.editor.findrefs.FindReferencesHandler"
			commandId="org.eclipse.xtext.ui.editor.FindReferences">
			<activeWhen>
				<reference
					definitionId="org.uniovi.dsl.scheduling.Scheduling.Editor.opened">
				</reference>
			</activeWhen>
		</handler>
	</extension>
	
	<!-- Content type declaration was originally here-->
	
	<!-- adding resource factories -->
	<extension
		point="org.eclipse.emf.ecore.extension_parser">
		<parser
			class="org.uniovi.dsl.scheduling.ui.SchedulingExecutableExtensionFactory:org.eclipse.xtext.resource.IResourceFactory"
			type="sched">
		</parser>
	</extension>
	<extension point="org.eclipse.xtext.extension_resourceServiceProvider">
		<resourceServiceProvider
			class="org.uniovi.dsl.scheduling.ui.SchedulingExecutableExtensionFactory:org.eclipse.xtext.ui.resource.IResourceUIServiceProvider"
			uriExtension="sched">
		</resourceServiceProvider>
	</extension>
	<!-- marker definitions for org.uniovi.dsl.scheduling.Scheduling -->
	<extension
			id="scheduling.check.fast"
			name="Scheduling Problem"
			point="org.eclipse.core.resources.markers">
		<super type="org.eclipse.xtext.ui.check.fast"/>
		<persistent value="true"/>
	</extension>
	<extension
			id="scheduling.check.normal"
			name="Scheduling Problem"
			point="org.eclipse.core.resources.markers">
		<super type="org.eclipse.xtext.ui.check.normal"/>
		<persistent value="true"/>
	</extension>
	<extension
			id="scheduling.check.expensive"
			name="Scheduling Problem"
			point="org.eclipse.core.resources.markers">
		<super type="org.eclipse.xtext.ui.check.expensive"/>
		<persistent value="true"/>
	</extension>
	<extension point="org.eclipse.ui.preferencePages">
		<page
			category="org.uniovi.dsl.scheduling.Scheduling"
			class="org.uniovi.dsl.scheduling.ui.SchedulingExecutableExtensionFactory:org.eclipse.xtext.ui.validation.ValidatorPreferencePage"
			id="org.uniovi.dsl.scheduling.Scheduling.validator.preferencePage"
			name="Errors/Warnings">
			<keywordReference id="org.uniovi.dsl.scheduling.ui.keyword_Scheduling"/>
		</page>
	</extension>
	<extension point="org.eclipse.ui.preferencePages">
		<page
			category="org.uniovi.dsl.scheduling.Scheduling"
			class="org.uniovi.dsl.scheduling.ui.SchedulingExecutableExtensionFactory:org.eclipse.xtext.builder.preferences.BuilderPreferencePage"
			id="org.uniovi.dsl.scheduling.Scheduling.compiler.preferencePage"
			name="Compiler">
			<keywordReference id="org.uniovi.dsl.scheduling.ui.keyword_Scheduling"/>
		</page>
	</extension>
	<extension point="org.eclipse.ui.propertyPages">
		<page
			category="org.uniovi.dsl.scheduling.Scheduling"
			class="org.uniovi.dsl.scheduling.ui.SchedulingExecutableExtensionFactory:org.eclipse.xtext.builder.preferences.BuilderPreferencePage"
			id="org.uniovi.dsl.scheduling.Scheduling.compiler.propertyPage"
			name="Compiler">
			<keywordReference id="org.uniovi.dsl.scheduling.ui.keyword_Scheduling"/>
			<enabledWhen>
				<adapt type="org.eclipse.core.resources.IProject"/>
			</enabledWhen>
			<filter name="projectNature" value="org.eclipse.xtext.ui.shared.xtextNature"/>
		</page>
	</extension>
	<extension point="org.eclipse.ui.menus">
		<menuContribution locationURI="popup:#TextEditorContext?after=xtext.ui.openDeclaration">
			<command
				commandId="org.eclipse.xtext.ui.OpenGeneratedFileCommand"
				id="org.uniovi.dsl.scheduling.Scheduling.OpenGeneratedCode"
				style="push">
				<visibleWhen checkEnabled="false">
					<reference definitionId="org.uniovi.dsl.scheduling.Scheduling.Editor.opened" />
				</visibleWhen>
			</command>
		</menuContribution>
	</extension>
	<extension point="org.eclipse.ui.handlers">
		<handler
			class="org.uniovi.dsl.scheduling.ui.SchedulingExecutableExtensionFactory:org.eclipse.xtext.ui.generator.trace.OpenGeneratedFileHandler"
			commandId="org.eclipse.xtext.ui.OpenGeneratedFileCommand">
			<activeWhen>
				<reference definitionId="org.uniovi.dsl.scheduling.Scheduling.Editor.opened" />
			</activeWhen>
		</handler>
	</extension>
	<!-- Quick Outline -->
	<extension
		point="org.eclipse.ui.handlers">
		<handler
			class="org.uniovi.dsl.scheduling.ui.SchedulingExecutableExtensionFactory:org.eclipse.xtext.ui.editor.outline.quickoutline.ShowQuickOutlineActionHandler"
			commandId="org.eclipse.xtext.ui.editor.outline.QuickOutline">
			<activeWhen>
				<reference
					definitionId="org.uniovi.dsl.scheduling.Scheduling.Editor.opened">
				</reference>
			</activeWhen>
		</handler>
	</extension>
	<extension
		point="org.eclipse.ui.commands">
		<command
			description="Open the quick outline."
			id="org.eclipse.xtext.ui.editor.outline.QuickOutline"
			name="Quick Outline">
		</command>
	</extension>
	<extension point="org.eclipse.ui.menus">
		<menuContribution
			locationURI="popup:#TextEditorContext?after=group.open">
			<command commandId="org.eclipse.xtext.ui.editor.outline.QuickOutline"
				style="push"
				tooltip="Open Quick Outline">
				<visibleWhen checkEnabled="false">
					<reference definitionId="org.uniovi.dsl.scheduling.Scheduling.Editor.opened"/>
				</visibleWhen>
			</command>
		</menuContribution>
	</extension>
	<!-- quickfix marker resolution generator for org.uniovi.dsl.scheduling.Scheduling -->
	<extension
			point="org.eclipse.ui.ide.markerResolution">
		<markerResolutionGenerator
			class="org.uniovi.dsl.scheduling.ui.SchedulingExecutableExtensionFactory:org.eclipse.xtext.ui.editor.quickfix.MarkerResolutionGenerator"
			markerType="org.uniovi.dsl.scheduling.ui.scheduling.check.fast">
			<attribute
				name="FIXABLE_KEY"
				value="true">
			</attribute>
		</markerResolutionGenerator>
		<markerResolutionGenerator
			class="org.uniovi.dsl.scheduling.ui.SchedulingExecutableExtensionFactory:org.eclipse.xtext.ui.editor.quickfix.MarkerResolutionGenerator"
			markerType="org.uniovi.dsl.scheduling.ui.scheduling.check.normal">
			<attribute
				name="FIXABLE_KEY"
				value="true">
			</attribute>
		</markerResolutionGenerator>
		<markerResolutionGenerator
			class="org.uniovi.dsl.scheduling.ui.SchedulingExecutableExtensionFactory:org.eclipse.xtext.ui.editor.quickfix.MarkerResolutionGenerator"
			markerType="org.uniovi.dsl.scheduling.ui.scheduling.check.expensive">
			<attribute
				name="FIXABLE_KEY"
				value="true">
			</attribute>
		</markerResolutionGenerator>
	</extension>
	<!-- Rename Refactoring -->
	<extension point="org.eclipse.ui.handlers">
		<handler
			class="org.uniovi.dsl.scheduling.ui.SchedulingExecutableExtensionFactory:org.eclipse.xtext.ui.refactoring.ui.DefaultRenameElementHandler"
			commandId="org.eclipse.xtext.ui.refactoring.RenameElement">
			<activeWhen>
				<reference
					definitionId="org.uniovi.dsl.scheduling.Scheduling.Editor.opened">
				</reference>
			</activeWhen>
		</handler>
	</extension>
	<extension point="org.eclipse.ui.menus">
		<menuContribution
			locationURI="popup:#TextEditorContext?after=group.edit">
			<command commandId="org.eclipse.xtext.ui.refactoring.RenameElement"
				style="push">
				<visibleWhen checkEnabled="false">
					<reference
						definitionId="org.uniovi.dsl.scheduling.Scheduling.Editor.opened">
					</reference>
				</visibleWhen>
			</command>
		</menuContribution>
	</extension>
	<extension point="org.eclipse.ui.preferencePages">
		<page
			category="org.uniovi.dsl.scheduling.Scheduling"
			class="org.uniovi.dsl.scheduling.ui.SchedulingExecutableExtensionFactory:org.eclipse.xtext.ui.refactoring.ui.RefactoringPreferencePage"
			id="org.uniovi.dsl.scheduling.Scheduling.refactoring"
			name="Refactoring">
			<keywordReference id="org.uniovi.dsl.scheduling.ui.keyword_Scheduling"/>
		</page>
	</extension>
	<extension point="org.eclipse.compare.contentViewers">
		<viewer id="org.uniovi.dsl.scheduling.Scheduling.compare.contentViewers"
			class="org.uniovi.dsl.scheduling.ui.SchedulingExecutableExtensionFactory:org.eclipse.xtext.ui.compare.InjectableViewerCreator"
			extensions="sched">
		</viewer>
		<contentTypeBinding
			contentTypeId="org.uniovi.dsl.scheduling.Scheduling.contenttype"
			contentViewerId="org.uniovi.dsl.scheduling.Scheduling.compare.contentViewers" />
	</extension>
	<extension point="org.eclipse.compare.contentMergeViewers">
		<viewer id="org.uniovi.dsl.scheduling.Scheduling.compare.contentMergeViewers"
			class="org.uniovi.dsl.scheduling.ui.SchedulingExecutableExtensionFactory:org.eclipse.xtext.ui.compare.InjectableViewerCreator"
			extensions="sched" label="Scheduling Compare">
		</viewer>
		<contentTypeBinding
			contentTypeId="org.uniovi.dsl.scheduling.Scheduling.contenttype"
			contentMergeViewerId="org.uniovi.dsl.scheduling.Scheduling.compare.contentMergeViewers" />
	</extension>
	<extension point="org.eclipse.ui.editors.documentProviders">
		<provider id="org.uniovi.dsl.scheduling.Scheduling.editors.documentProviders"
			class="org.uniovi.dsl.scheduling.ui.SchedulingExecutableExtensionFactory:org.eclipse.xtext.ui.editor.model.XtextDocumentProvider"
			extensions="sched">
		</provider>
	</extension>
	
	<!-- DSL editor -->
	<extension
		point="org.eclipse.ui.editors">
		<editor
			class="org.uniovi.dsl.scheduling.ui.SchedulingExecutableExtensionFactory:org.eclipse.xtext.ui.editor.XtextEditor"
			contributorClass="org.eclipse.ui.editors.text.TextEditorActionContributor"
			default="true"
			extensions="sched"
			id="org.uniovi.dsl.scheduling.Scheduling"
			name="Scheduling Editor"
			icon="icons/file_maint.png">
		</editor>
	</extension>
	
	<!-- DSL content type -->
	<extension point="org.eclipse.core.contenttype.contentTypes">
		<content-type
			base-type="org.eclipse.core.runtime.text"
			file-extensions="sched"
			id="org.uniovi.dsl.scheduling.Scheduling.contenttype"
			name="Scheduling File"
			priority="normal">
		</content-type>
	</extension>
	
	<!-- DSL file type -->
	<extension point="org.eclipse.team.core.fileTypes">
		<fileTypes
			extension="sched"
			type="text">
		</fileTypes>
	</extension>
			
	
	<!-- Disable automatic code generation -->

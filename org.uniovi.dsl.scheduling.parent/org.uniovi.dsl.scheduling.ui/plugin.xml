	<extension point="org.eclipse.xtext.builder.participant">
		<participant
			class="org.uniovi.dsl.scheduling.ui.SchedulingExecutableExtensionFactory:org.eclipse.xtext.builder.IXtextBuilderParticipant"
			fileExtensions="sched"/>
	</extension>
-->
	
	<!-- Code execution -->
	 <extension
       point="org.eclipse.ui.commands">
	    <command
	          defaultHandler="org.uniovi.dsl.scheduling.ui.SchedulingExecutableExtensionFactory:org.uniovi.dsl.scheduling.ui.GenerationHandler"
	          id="org.uniovi.dsl.scheduling.ui.run"
	          name="button_run">
	    </command>
	 </extension>
	 <extension
	       point="org.eclipse.ui.menus">
	    <menuContribution
	          allPopups="false"
	          locationURI="toolbar:org.eclipse.ui.main.toolbar">
	       <toolbar
	             id="org.xtext.dsl.visualization.toolbar">
	          <command
	                commandId="org.uniovi.dsl.scheduling.ui.run"
	                icon="icons/run_exc.png"
	                style="push"
	                tooltip="Run code">
	          </command>
	       </toolbar>
	    </menuContribution>
	 </extension>
	 
</plugin>
